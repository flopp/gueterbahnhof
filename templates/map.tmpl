{{define "map-content"}}
<section class="map-page-heading">
  <div><p class="eyebrow"><span class="eyebrow-dot"></span> ORIENTIERUNG IM QUARTIER</p><h1>Hier bist du<br><em>mittendrin.</em></h1></div>
  <p>Das Güterbahnhof-Areal und die Orte im Quartier. Verschiebe die Karte und zoome hinein, um dich umzusehen.</p>
</section>
<section class="map-section">
  <div class="map-frame">
    <div id="map" role="region" aria-label="Interaktive Karte des Quartiers Güterbahnhof"
      data-tile-url="{{.TileURL}}"
      data-boundary-url="{{.BasePath}}/data/gueterbahnhof.geojson">
      <p class="map-fallback">Die interaktive Karte wird geladen. Die Ortsliste findest du darunter.</p>
    </div>
    <p id="map-status" class="map-status" role="status" hidden></p>
  </div>
  <div class="map-caption"><span><span class="legend-boundary"></span> Quartiersgrenze</span><span><span class="legend-place"></span> Orte im Quartier</span><span class="map-caption-note">Karte und Ortsliste lassen sich unabhängig voneinander nutzen.</span><span class="map-caption-provider">Kartenkacheln: <a href="{{.TileAttributionURL}}" rel="noopener noreferrer">{{.TileAttribution}}</a></span></div>
</section>
<section class="map-places">
  <div class="map-places-heading"><div><p class="eyebrow">ENTDECKEN</p><h2>Orte in der <em>Nähe.</em></h2></div><a class="text-link" href="{{.BasePath}}/places/">Alle Orte <span aria-hidden="true">→</span></a></div>
  {{if .Places}}
  <div class="map-place-list">
    {{range .Places}}
    <a class="map-place" href="{{.URL}}" {{if .HasCoordinates}}data-lat="{{.Latitude}}" data-lon="{{.Longitude}}"{{end}}>
      <span class="map-place-number">{{.Index}}</span><span><strong>{{.Name}}</strong><small>{{.Category}} · {{.Address}}</small></span><span class="map-place-arrow" aria-hidden="true">↗</span>
    </a>
    {{end}}
  </div>
  {{else}}
  <div class="empty-state map-empty"><span class="empty-symbol" aria-hidden="true">✳</span><div><h3>Orte werden ergänzt.</h3><p>Sobald die ersten Einträge da sind, findest du sie hier und als Markierungen auf der Karte.</p></div></div>
  {{end}}
</section>
{{end}}
